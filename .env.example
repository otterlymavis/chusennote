# Example deployment environment. chusennote does not load this file itself;
# export the variables in your service manager or pass a private `.env` with
# Docker's `--env-file` option. Never put real credentials in this tracked file.

# Hosted database (omit to use a local SQLite file).
CHUSENNOTE_DATABASE_URL=

# FCM HTTP v1. Omit GOOGLE_APPLICATION_CREDENTIALS on runtimes that provide
# Application Default Credentials through an attached workload identity.
CHUSENNOTE_FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# Optional local-workspace SMTP delivery.
CHUSENNOTE_SMTP_HOST=
CHUSENNOTE_SMTP_PORT=587
CHUSENNOTE_SMTP_USER=
CHUSENNOTE_SMTP_PASSWORD=
CHUSENNOTE_SMTP_FROM=
CHUSENNOTE_NOTIFY_EMAIL=

# Optional local-workspace chat delivery. Webhook URLs and access tokens are
# secrets: keep real values in an ignored .env or your service manager.
CHUSENNOTE_SLACK_WEBHOOK_URL=
CHUSENNOTE_DISCORD_WEBHOOK_URL=
CHUSENNOTE_LINE_CHANNEL_ACCESS_TOKEN=
CHUSENNOTE_LINE_TARGET_ID=

# Enable only behind a reverse proxy that overwrites X-Forwarded-Proto.
CHUSENNOTE_TRUST_PROXY_HEADERS=0

# Optional managed discovery provider: tavily, brave, bing, or serpapi.
CHUSENNOTE_SEARCH_PROVIDER=
CHUSENNOTE_SEARCH_API_KEY=

# Android release-build signing. Keep the keystore itself outside the
# repository; these values are consumed by Gradle, not by the running server.
CHUSENNOTE_ANDROID_KEYSTORE=
CHUSENNOTE_ANDROID_STORE_PASSWORD=
CHUSENNOTE_ANDROID_KEY_ALIAS=
CHUSENNOTE_ANDROID_KEY_PASSWORD=
